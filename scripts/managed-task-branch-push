#!/bin/sh
set -eu

script_path=$(/usr/bin/realpath "$0")
script_dir=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script_path")" && pwd)
stagehand_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
workspace_config="$stagehand_root/.local/workspace.yaml"

usage() {
    cat >&2 <<'EOF'
usage: managed-task-branch-push --task-record <path> --expected-head <commit>
       [--create-draft-pr --title <title> --body <body>]

Publishes only the author task branch and exact head authorized by the durable
Stagehand task record. When explicitly requested, it also creates the one
authorized draft pull request from that already-published head. Direct git
pushes and GitHub mutations remain forbidden for managed roles.
EOF
}

task_record=
expected_head=
create_draft_pr=false
pr_title=
pr_body=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --task-record) task_record=${2-}; shift 2 ;;
        --expected-head) expected_head=${2-}; shift 2 ;;
        --create-draft-pr) create_draft_pr=true; shift ;;
        --title) pr_title=${2-}; shift 2 ;;
        --body) pr_body=${2-}; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) echo "unknown argument: $1" >&2; usage; exit 2 ;;
    esac
done

if [ -z "$task_record" ] || [ -z "$expected_head" ]; then
    echo "task record and expected head are required" >&2
    usage
    exit 2
fi
if [ "$create_draft_pr" = true ]; then
    if [ -z "$pr_title" ] || [ -z "$pr_body" ]; then
        echo "draft pull-request title and body are required" >&2
        exit 2
    fi
elif [ -n "$pr_title" ] || [ -n "$pr_body" ]; then
    echo "title and body require --create-draft-pr" >&2
    exit 2
fi
if [ ! -f "$task_record" ]; then
    echo "task record does not exist: $task_record" >&2
    exit 2
fi
if [ ! -f "$workspace_config" ]; then
    echo "machine-readable workspace configuration is missing: $workspace_config" >&2
    exit 1
fi
trusted_command_path=$(/usr/bin/ruby -ryaml -e '
  workspace = YAML.safe_load(File.read(ARGV.fetch(0)), permitted_classes: [], aliases: false)
  puts workspace.fetch("trusted_command_path")
' "$workspace_config") || {
    echo "could not read the trusted command path" >&2
    exit 1
}
case ":$trusted_command_path:" in
    *::*|*:.:*|*:/.:*|*:/../*|*:/..:*)
        echo "trusted command path contains a relative or empty component" >&2
        exit 1
        ;;
esac
old_ifs=$IFS
IFS=:
for command_directory in $trusted_command_path; do
    case "$command_directory" in
        /*) ;;
        *) echo "trusted command path components must be absolute" >&2; exit 1 ;;
    esac
done
IFS=$old_ifs
PATH=$trusted_command_path
export PATH
case "$expected_head" in
    *[!0-9A-Fa-f]*|'') echo "invalid expected head" >&2; exit 2 ;;
esac
if [ "${#expected_head}" -ne 40 ] && [ "${#expected_head}" -ne 64 ]; then
    echo "expected head must be a full commit ID" >&2
    exit 2
fi

for command_name in ruby jq git gh realpath awk env mktemp rm; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "$command_name is required for guarded task-branch publication" >&2
        exit 1
    fi
done

record_json=$(ruby -ryaml -rjson -e '
  task = YAML.safe_load(File.read(ARGV.fetch(0)), permitted_classes: [], aliases: false)
  workspace = YAML.safe_load(File.read(ARGV.fetch(1)), permitted_classes: [], aliases: false)
  target = task.fetch("development_target")
  publication = task.fetch("publication")
  push_url = target.fetch("push_url")
  github = target.fetch("github")
  normalized_push_repository =
    case push_url
    when /\Agit@([^:]+):([^\/]+)\/(.+)\.git\z/
      "#{$1}/#{$2}/#{$3}"
    when /\A(?:ssh:\/\/git@|https:\/\/)([^\/]+)\/([^\/]+)\/(.+)\.git\z/
      "#{$1}/#{$2}/#{$3}"
    end
  result = {
    task_id: task.fetch("task_id"),
    task_records_directory: workspace.fetch("task_records_directory"),
    mode: task.fetch("mode"),
    authority_profile: task.fetch("project").fetch("authority_profile"),
    author: task.fetch("agents").fetch("author"),
    state: task.fetch("state").fetch("name"),
    target_path: target.fetch("path"),
    target_remote: target.fetch("remote"),
    target_push_url: push_url,
    target_github: github,
    target_repository_identity_matches: normalized_push_repository == github,
    target_branch: target.fetch("branch"),
    target_ready: target.fetch("ready"),
    integration_branch: task.fetch("integration").fetch("branch"),
    publication_authorized: publication.fetch("authorized"),
    publication_role: publication.fetch("role"),
    publication_head: publication.fetch("expected_head"),
    publication_remote: publication.fetch("remote"),
    publication_branch: publication.fetch("branch"),
    draft_creation_authorized: task.fetch("pull_request").fetch("draft_creation_authorized")
  }
  puts JSON.generate(result)
' "$task_record" "$workspace_config") || {
    echo "could not read the task-branch publication contract" >&2
    exit 1
}

record_value() {
    printf '%s\n' "$record_json" | jq -er --arg field "$1" '.[$field]'
}
task_id=$(record_value task_id)
case "$task_id" in
    *[!A-Za-z0-9._-]*|'') echo "invalid task ID in task record" >&2; exit 1 ;;
esac
canonical_record=$(realpath "$task_record")
task_records_directory=$(record_value task_records_directory)
case "$task_records_directory" in
    /*) ;;
    *) echo "configured task-record directory must be absolute" >&2; exit 1 ;;
esac
if [ ! -d "$task_records_directory" ]; then
    echo "configured task-record directory does not exist" >&2
    exit 1
fi
task_records_directory=$(realpath "$task_records_directory")
expected_record="$task_records_directory/$task_id.yaml"
if [ "$canonical_record" != "$expected_record" ]; then
    echo "task record is outside the canonical Stagehand task path" >&2
    exit 1
fi

require_value() {
    field=$1
    expected=$2
    actual=$(record_value "$field") || {
        echo "missing publication contract field: $field" >&2
        exit 1
    }
    if [ "$actual" != "$expected" ]; then
        echo "publication contract mismatch for $field: expected $expected, found $actual" >&2
        exit 1
    fi
}

require_value mode development
author=$(record_value author)
case "$author" in
    *[!A-Za-z0-9_-]*|'') echo "invalid author in task record" >&2; exit 1 ;;
esac
require_value publication_authorized true
require_value publication_role author
require_value publication_head "$expected_head"
require_value target_ready true
require_value target_repository_identity_matches true

state=$(record_value state)
case "$state" in
    drafting|resolving) ;;
    *) echo "task state does not authorize publication: $state" >&2; exit 1 ;;
esac

target_path=$(record_value target_path)
target_remote=$(record_value target_remote)
target_push_url=$(record_value target_push_url)
target_github=$(record_value target_github)
target_branch=$(record_value target_branch)
integration_branch=$(record_value integration_branch)
require_value publication_remote "$target_remote"
require_value publication_branch "$target_branch"
case "$target_path" in
    /*) ;;
    *) echo "development target must be an absolute path" >&2; exit 1 ;;
esac
case "$target_remote" in
    *[!A-Za-z0-9._-]*|'') echo "invalid target remote" >&2; exit 1 ;;
esac
case "$target_push_url" in
    git@*:*/*.git|ssh://git@*/*/*.git|https://*/*/*.git) ;;
    *) echo "invalid canonical push URL" >&2; exit 1 ;;
esac
case "$target_github" in
    *[!A-Za-z0-9._/-]*|*//*|/*|*/|'') echo "invalid canonical GitHub repository" >&2; exit 1 ;;
esac
case "$target_branch" in
    main|master|refs/heads/main|refs/heads/master|HEAD:*|-*|*[!A-Za-z0-9._/-]*|'')
        echo "invalid or forbidden task branch: $target_branch" >&2
        exit 1
        ;;
esac
if [ "$target_branch" = "$integration_branch" ]; then
    echo "task branch must not be the integration branch" >&2
    exit 1
fi
case "$integration_branch" in
    main|master|refs/heads/main|refs/heads/master|-*|*[!A-Za-z0-9._/-]*|'')
        echo "invalid or forbidden integration branch: $integration_branch" >&2
        exit 1
        ;;
esac
if [ ! -d "$target_path" ]; then
    echo "development target does not exist: $target_path" >&2
    exit 1
fi
target_path=$(realpath "$target_path")

current_branch=$(git -C "$target_path" branch --show-current)
current_head=$(git -C "$target_path" rev-parse HEAD)
if [ "$current_branch" != "$target_branch" ] || [ "$current_head" != "$expected_head" ]; then
    echo "development target branch or head changed after publication authorization" >&2
    exit 1
fi
remote_url=$(git -C "$target_path" remote get-url "$target_remote")
remote_push_url=$(git -C "$target_path" remote get-url --push "$target_remote")
if [ "$remote_url" != "$target_push_url" ] || [ "$remote_push_url" != "$target_push_url" ]; then
    echo "development target remote identity changed after authorization" >&2
    exit 1
fi

# Build the network-capable push in a fresh bare repository. Author-controlled
# hooks, helpers, remotes, URL rewrites, and repository configuration therefore
# cannot execute across the publisher's sandbox boundary.
publish_temp=$(mktemp -d)
trap 'rm -rf "$publish_temp"' EXIT HUP INT TERM
bundle_path="$publish_temp/task.bundle"
bare_path="$publish_temp/repository.git"
git -c core.hooksPath=/dev/null -C "$target_path" bundle create \
    "$bundle_path" "refs/heads/$target_branch"
env -i PATH="$PATH" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git init --bare "$bare_path" >/dev/null
env -i PATH="$PATH" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git -c protocol.file.allow=always -C "$bare_path" fetch "$bundle_path" \
    "refs/heads/$target_branch:refs/heads/$target_branch" >/dev/null
# The fixed URL and refspec exclude repository aliases, deletion, force,
# integration, and main updates.
env -i PATH="$PATH" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}" git -c core.hooksPath=/dev/null \
    -c protocol.ext.allow=never -c protocol.file.allow=never -C "$bare_path" \
    push "$target_push_url" \
    "refs/heads/$target_branch:refs/heads/$target_branch"
remote_head=$(env -i PATH="$PATH" GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}" \
    git -c protocol.ext.allow=never -c protocol.file.allow=never \
    -C "$bare_path" ls-remote --heads "$target_push_url" \
    "refs/heads/$target_branch" | awk 'NR == 1 { print $1 }')
if [ "$remote_head" != "$expected_head" ]; then
    echo "remote task branch does not match the authorized head" >&2
    exit 1
fi

pull_request_url=
if [ "$create_draft_pr" = true ]; then
    require_value state drafting
    require_value draft_creation_authorized true

    # The explicit remote head prevents gh from performing an implicit push.
    existing_prs=$(gh pr list -R "$target_github" --state all \
        --base "$integration_branch" --head "$target_branch" \
        --json number --limit 2) || {
        echo "could not check for an existing task pull request" >&2
        exit 1
    }
    if [ "$(printf '%s\n' "$existing_prs" | jq -er 'length')" -ne 0 ]; then
        echo "a pull request already exists for the authorized task branch" >&2
        exit 1
    fi
    pull_request_url=$(gh pr create -R "$target_github" --draft \
        --base "$integration_branch" --head "$target_branch" \
        --title "$pr_title" --body "$pr_body") || {
        echo "draft pull-request creation failed" >&2
        exit 1
    }
    pr_json=$(gh pr view "$pull_request_url" -R "$target_github" \
        --json state,isDraft,baseRefName,headRefName,headRefOid,url) || {
        echo "could not verify the created draft pull request" >&2
        exit 1
    }
    if ! printf '%s\n' "$pr_json" | jq -e \
        --arg base "$integration_branch" --arg branch "$target_branch" \
        --arg head "$expected_head" --arg url "$pull_request_url" \
        '.state == "OPEN" and .isDraft == true and .baseRefName == $base and
         .headRefName == $branch and .headRefOid == $head and .url == $url' \
        >/dev/null; then
        echo "created pull request does not match the authorized repository, base, branch, and head" >&2
        exit 1
    fi
fi

jq -cn --arg task "$task_id" --arg branch "$target_branch" \
    --arg head "$expected_head" --arg pull_request "$pull_request_url" \
    '{status:"published",task:$task,branch:$branch,head:$head}
     + if $pull_request == "" then {} else {pullRequest:$pull_request} end'
