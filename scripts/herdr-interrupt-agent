#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    echo "usage: $0 <agent-name>" >&2
    exit 2
fi

agent_name=$1
case "$agent_name" in
    ''|*[!a-z0-9_-]*|[!a-z]*)
        echo "invalid Herdr agent name: $agent_name" >&2
        exit 2
        ;;
esac

if [ "${#agent_name}" -gt 32 ]; then
    echo "invalid Herdr agent name: $agent_name" >&2
    exit 2
fi

# Escape interrupts the current agent interaction without granting the
# orchestrator authority to submit approvals or arbitrary terminal input.
exec herdr agent send-keys "$agent_name" esc
